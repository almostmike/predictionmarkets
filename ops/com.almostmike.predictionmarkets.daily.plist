<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily session at 9:00 local time (the Mac is on Pacific time). Install: see ops/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.almostmike.predictionmarkets.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/launchd.out</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
