{
  "name": "predictionmarkets",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent trades a $100 Polymarket US account using Quotient forecasts. Public ledger.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "markets": "node scripts/markets.ts",
    "reconcile": "node scripts/reconcile.ts",
    "scan": "sh scripts/scan-secrets.sh",
    "quotient": "QUOTIENT_DISABLE_UPDATE_CHECK=1 node --env-file-if-exists=.env node_modules/.bin/quotient"
  },
  "dependencies": {
    "polymarket-us": "0.1.1",
    "quotient-forecasting": "0.8.36"
  }
}
