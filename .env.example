# Copy to .env and fill in. .env is gitignored; never commit it.
# Keys come from https://polymarket.us/developer (the secret is shown once).
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Optional: `quotient setup` stores the key in ~/.config/quotient/, which is enough.
# Credits are bought in the Quotient console.
QUOTIENT_API_KEY=
QUOTIENT_DISABLE_UPDATE_CHECK=1

# Orders are only logged until the operator sets this to false at go-live.
DRY_RUN=true
